# Copy to .env.local only if persistent local configuration is needed.
# Never commit or share the real AppSecret.
XGJ_APP_KEY=
XGJ_APP_SECRET=
XGJ_BASE_URL=https://open.goofish.pro

# Development defaults; production settings require explicit values.
DJANGO_SETTINGS_MODULE=app.config.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=seller
POSTGRES_USER=seller
POSTGRES_PASSWORD=seller-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
REDIS_URL=redis://127.0.0.1:56379/0
